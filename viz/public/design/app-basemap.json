{
  "version": 8,
  "name": "Calm basemap",
  "metadata": {
    "basemap:version": "0.1",
    "basemap:derived-from": "Layer logic informed by OpenFreeMap's Positron style (OpenMapTiles schema); colors come from the design tokens.",
    "basemap:tiles": "OpenFreeMap public instance: keyless, no usage limits, commercial use allowed."
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\" target=\"_blank\">&copy; OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a>"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#F5F7F4" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["==", ["get", "class"], "wood"]
      ],
      "paint": {
        "fill-color": "#D6E3D6",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 12, 0.8],
        "fill-antialias": false
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["==", ["get", "class"], "grass"]
      ],
      "paint": { "fill-color": "#E0EADE", "fill-opacity": 0.8, "fill-antialias": false }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["==", ["get", "class"], "residential"]
      ],
      "paint": {
        "fill-color": "#EEF1ED",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 14, 0.3, 16, 0]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
      "paint": {
        "fill-color": "#DCE9DC",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.6, 13, 0.9]
      }
    },
    {
      "id": "aeroway-area",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 10,
      "filter": ["all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["match", ["get", "class"], ["runway", "taxiway", "apron"], true, false]
      ],
      "paint": { "fill-color": "#E5EBE6", "fill-opacity": 0.8 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["all",
        ["match", ["geometry-type"], ["Polygon", "MultiPolygon"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": { "fill-color": "#C7D7D6", "fill-antialias": true }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "paint": {
        "line-color": "#C7D7D6",
        "line-width": ["interpolate", ["exponential", 1.3], ["zoom"], 9, 0.8, 16, 3.5]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#E7ECE6",
        "fill-outline-color": "#DCE4DD",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14.5, 1]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 14,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "path"]
      ],
      "paint": {
        "line-color": "#AFBAB2",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 14, 0.7, 18, 2]
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["minor", "service", "track"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#D2DCD4",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 1, 14, 3, 18, 14]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["minor", "service", "track"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FDFDFC",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 12, 0.5, 14, 2, 18, 11.5]
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#C3CEC5",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 9, 1.2, 12, 3, 18, 18]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 9, 0.6, 12, 2, 18, 15]
      }
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "motorway"]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#B7C3BA",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 5, 0.8, 12, 4, 18, 22]
      }
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "motorway"]
      ],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#FAFBF9",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 5, 0.4, 12, 2.8, 18, 18]
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "rail"]
      ],
      "paint": {
        "line-color": "#C6CFC7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.8, 16, 2]
      }
    },
    {
      "id": "railway-ties",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["==", ["get", "class"], "rail"]
      ],
      "paint": {
        "line-color": "#F5F7F4",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 16, 1.2],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 10,
      "filter": ["all",
        ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
        ["match", ["get", "class"], ["runway", "taxiway"], true, false]
      ],
      "paint": {
        "line-color": "#E2E8E3",
        "line-width": ["interpolate", ["exponential", 1.4], ["zoom"], 10, 1, 16, 12]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all",
        [">=", ["get", "admin_level"], 3],
        ["<=", ["get", "admin_level"], 6],
        ["!=", ["get", "maritime"], 1]
      ],
      "paint": {
        "line-color": "#9FABA2",
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all",
        ["==", ["get", "admin_level"], 2],
        ["!=", ["get", "maritime"], 1]
      ],
      "paint": {
        "line-color": "#8A978E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 1, 10, 1.6],
        "line-dasharray": [5, 2]
      }
    },
    {
      "id": "label-waterway",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 13,
      "filter": ["match", ["geometry-type"], ["LineString", "MultiLineString"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 12.5,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#33585D",
        "text-halo-color": "#F5F7F4",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-water",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 9, 12.5, 14, 15],
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#33585D",
        "text-halo-color": "#C7D7D6",
        "text-halo-width": 1
      }
    },
    {
      "id": "label-road-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["match", ["get", "class"], ["minor", "service", "path"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#5C665F",
        "text-halo-color": "#FDFDFC",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-road-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 12, 17, 14]
      },
      "paint": {
        "text-color": "#5C665F",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "label-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 12,
      "filter": ["match", ["get", "class"], ["suburb", "neighbourhood", "quarter", "hamlet"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12.5,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4A574F",
        "text-halo-color": "#F5F7F4",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "label-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "village"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 12, 14, 15],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#37453D",
        "text-halo-color": "#F5F7F4",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "label-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 13, 17],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#37453D",
        "text-halo-color": "#F5F7F4",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "label-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 9,
      "filter": ["==", ["get", "class"], "state"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 8, 14],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.2,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#8A968D",
        "text-halo-color": "#F5F7F4",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 13, 11, 20],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#24312B",
        "text-halo-color": "#F5F7F4",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "label-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 7,
      "filter": ["==", ["get", "class"], "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 2, 12, 6, 17],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#37453D",
        "text-halo-color": "#F5F7F4",
        "text-halo-width": 1.8
      }
    }
  ]
}
